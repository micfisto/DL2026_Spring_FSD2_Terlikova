# Структура .env:
#   - DATABASE_URL        (обязательно) строка подключения к PostgreSQL
#   - JWT_SECRET_KEY      (обязательно) секретный ключ для JWT токенов
#   - VITE_API_URL        (опционально) URL бэкенда для фронтенда
#   - SUPABASE_PUBLISHABLE_KEY (опционально) публичный ключ Supabase
#   - SUPABASE_SECRET_KEY      (опционально) секретный ключ Supabase

# Примеры подключения:
# Supabase: postgresql://user:password@host:5432/database
# Docker:   postgresql://postgres:postgres@db:5432/geoquiz
# Local:    postgresql://postgres:postgres@localhost:5432/geoquiz

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geoquiz

# Используйте надёжный случайный ключ в production
JWT_SECRET_KEY=dev-secret-key-change-in-production

# URL бэкенда для фронтенда (для Docker используйте http://backend:8000)
VITE_API_URL=http://localhost:8000

# Опционально: ключи Supabase (для будущего использования)
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
